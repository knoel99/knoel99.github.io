{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoel99.github.io/milady-2027/schemas/mff-1.0.json",
  "title": "MilaDy Field Format (MFF) 1.0 — métadonnées",
  "description": "Attributs racine d'un fichier MFF (HDF5 ou Zarr) après décodage : les attributs HDF5 sont convertis en types JSON et milady_parameters (chaîne JSON dans le fichier) est décodé en objet. Les sous-schémas $defs décrivent les attributs des groupes et jeux de données. Spécification lisible : specs/format-donnees.md.",
  "type": "object",
  "allOf": [
    {"$ref": "#/$defs/well_root"},
    {"$ref": "#/$defs/milady_root"}
  ],
  "$defs": {
    "well_root": {
      "description": "Attributs racine imposés par le format de The Well (PolymathicAI/the_well, docs/data_format.md).",
      "type": "object",
      "required": ["dataset_name", "grid_type", "n_spatial_dims", "n_trajectories", "simulation_parameters"],
      "properties": {
        "dataset_name": {"type": "string", "minLength": 1},
        "grid_type": {"type": "string", "enum": ["cartesian", "spherical", "fourier_fe_axisym"]},
        "n_spatial_dims": {"type": "integer", "minimum": 1, "maximum": 3},
        "n_trajectories": {"type": "integer", "minimum": 1},
        "simulation_parameters": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "milady_root": {
      "description": "Attributs MilaDy (préfixe milady_) ajoutés à la racine.",
      "type": "object",
      "required": ["milady_format_version", "milady_code", "milady_parameters", "milady_created", "milady_uuid"],
      "properties": {
        "milady_format_version": {"const": "1.0"},
        "milady_code": {
          "type": "string", "minLength": 1,
          "examples": ["mhd3d_torch", "mhd2d_numpy", "induction3d_numpy", "sfemans", "latu", "dedalus", "generated"]
        },
        "milady_code_version": {"type": "string"},
        "milady_git_commit": {"type": "string", "pattern": "^([0-9a-f]{7,40}(-dirty)?)?$"},
        "milady_parameters": {
          "type": "object",
          "description": "Tous les paramètres physiques de la simulation (Re, Rm, Pm, mu_r, nu, eta, forçage…), y compris ceux qui ne sont pas des nombres.",
          "additionalProperties": {"type": ["number", "string", "boolean", "array", "object", "null"]}
        },
        "milady_nondimensionalization": {"type": "string"},
        "milady_created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "milady_host": {"type": "string"},
        "milady_command": {"type": "string"},
        "milady_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "flag": {"type": "boolean"},
    "dimension": {
      "description": "Attributs d'un jeu de données de /dimensions (time, x, y, z).",
      "type": "object",
      "required": ["sample_varying"],
      "properties": {
        "sample_varying": {"$ref": "#/$defs/flag"},
        "time_varying": {"$ref": "#/$defs/flag"}
      }
    },
    "dimensions_group": {
      "type": "object",
      "required": ["spatial_dims"],
      "properties": {"spatial_dims": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3}}
    },
    "boundary": {
      "description": "Attributs d'un sous-groupe de /boundary_conditions.",
      "type": "object",
      "required": ["associated_dims", "associated_fields", "bc_type", "sample_varying", "time_varying"],
      "properties": {
        "associated_dims": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
        "associated_fields": {"type": "array", "items": {"type": "string"}},
        "bc_type": {"type": "string", "enum": ["periodic", "wall", "open", "PERIODIC", "WALL", "OPEN"]},
        "sample_varying": {"$ref": "#/$defs/flag"},
        "time_varying": {"$ref": "#/$defs/flag"}
      }
    },
    "named_group": {
      "description": "Attributs d'un groupe qui énumère ses membres (scalars, t0_fields, t1_fields, t2_fields, milady_diagnostics, milady_spectral).",
      "type": "object",
      "required": ["field_names"],
      "properties": {"field_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "scalar": {
      "type": "object",
      "required": ["sample_varying", "time_varying"],
      "properties": {"sample_varying": {"$ref": "#/$defs/flag"}, "time_varying": {"$ref": "#/$defs/flag"}}
    },
    "field": {
      "description": "Attributs d'un champ de t0_fields ou t1_fields.",
      "type": "object",
      "required": ["dim_varying", "sample_varying", "time_varying"],
      "properties": {
        "dim_varying": {"type": "array", "items": {"type": "boolean"}, "minItems": 1, "maxItems": 3},
        "sample_varying": {"$ref": "#/$defs/flag"},
        "time_varying": {"$ref": "#/$defs/flag"}
      }
    },
    "t2_field": {
      "description": "Attributs d'un champ de t2_fields : ceux d'un champ plus la symétrie du tenseur.",
      "allOf": [
        {"$ref": "#/$defs/field"},
        {
          "type": "object",
          "required": ["symmetric", "antisymmetric"],
          "properties": {"symmetric": {"$ref": "#/$defs/flag"}, "antisymmetric": {"$ref": "#/$defs/flag"}}
        }
      ]
    },
    "spectral_group": {
      "description": "Attributs du groupe optionnel /milady_spectral (coefficients rfftn des champs, domaines périodiques).",
      "type": "object",
      "required": ["field_names", "transform", "norm", "axes", "real_shape", "spatial_dims", "domain_lengths"],
      "properties": {
        "field_names": {"type": "array", "items": {"type": "string"}},
        "transform": {"const": "numpy.fft.rfftn"},
        "norm": {"type": "string", "enum": ["backward", "ortho", "forward"]},
        "axes": {"type": "array", "items": {"type": "integer"}},
        "real_shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "spatial_dims": {"type": "array", "items": {"type": "string"}},
        "domain_lengths": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "spectral_field": {
      "type": "object",
      "required": ["tensor_order", "physical_field", "kmax", "sample_varying", "time_varying"],
      "properties": {
        "tensor_order": {"type": "integer", "minimum": 0, "maximum": 2},
        "physical_field": {"type": "string"},
        "kmax": {"type": "integer", "minimum": -1},
        "sample_varying": {"$ref": "#/$defs/flag"},
        "time_varying": {"$ref": "#/$defs/flag"},
        "description": {"type": "string"}
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["sample_varying", "time_varying"],
      "properties": {"sample_varying": {"$ref": "#/$defs/flag"}, "time_varying": {"$ref": "#/$defs/flag"}}
    },
    "fourier_fe_group": {
      "description": "Attributs du groupe /milady_fourier_fe (extension grid_type = fourier_fe_axisym, SFEMaNS).",
      "type": "object",
      "required": ["field_names", "azimuthal_convention", "component_basis", "n_modes"],
      "properties": {
        "field_names": {"type": "array", "items": {"type": "string"}},
        "azimuthal_convention": {"type": "string"},
        "component_basis": {"type": "string", "enum": ["cylindrical"]},
        "n_modes": {"type": "integer", "minimum": 1}
      }
    },
    "fourier_fe_mesh": {
      "type": "object",
      "required": ["element_type", "n_nodes", "n_elements"],
      "properties": {
        "element_type": {"type": "string", "enum": ["P1", "P2"]},
        "n_nodes": {"type": "integer", "minimum": 3},
        "n_elements": {"type": "integer", "minimum": 1}
      }
    },
    "fourier_fe_field": {
      "type": "object",
      "required": ["mesh", "node_set", "tensor_order", "sample_varying", "time_varying"],
      "properties": {
        "mesh": {"type": "string"},
        "node_set": {"type": "string", "enum": ["all", "vertices"]},
        "tensor_order": {"type": "integer", "minimum": 0, "maximum": 1},
        "sample_varying": {"$ref": "#/$defs/flag"},
        "time_varying": {"$ref": "#/$defs/flag"}
      }
    }
  }
}
