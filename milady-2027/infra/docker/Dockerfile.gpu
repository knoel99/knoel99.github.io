# syntax=docker/dockerfile:1.7
# Image GPU (CUDA) du projet MilaDy : VM cloud GPU, et base de l'image Apptainer pour Slurm.
#
# Construction (depuis la racine du dépôt) :
#   docker build -f infra/docker/Dockerfile.gpu -t milady:gpu .
#   ou : make image-gpu
#
# Base : image officielle PyTorch, Python 3.12, torch 2.14.1, CUDA 12.6, cuDNN 9.
# CUDA 12.6 fonctionne avec un pilote NVIDIA >= 525 (compatibilité mineure CUDA 12) et couvre
# V100, A100, L4, L40S, H100. Pour des GPU Blackwell (B200, RTX 50xx), choisir une base CUDA 13 :
#   --build-arg BASE_IMAGE=pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
# (pilote >= 580 requis ; adapter alors torch dans requirements-gpu.txt).
#
# Mêmes options que le Dockerfile CPU : MILADY_UID, MILADY_GID, WITH_JUPYTER, GIT_COMMIT,
# --secret id=cacert,src=… (proxy TLS).

ARG BASE_IMAGE=pytorch/pytorch:2.14.1-cuda12.6-cudnn9-runtime
FROM ${BASE_IMAGE}

ARG MILADY_UID=1000
ARG MILADY_GID=1000
ARG WITH_JUPYTER=0
ARG GIT_COMMIT=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MILADY_ROOT=/opt/milady \
    MILADY_GIT_COMMIT=${GIT_COMMIT} \
    MPLBACKEND=Agg \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends git make curl ca-certificates postgresql-client tini \
 && rm -rf /var/lib/apt/lists/*

# Utilisateur non root (l'UID 1000 peut déjà exister dans certaines bases Ubuntu : on le réutilise).
RUN if getent passwd "${MILADY_UID}" >/dev/null; then \
        old="$(getent passwd "${MILADY_UID}" | cut -d: -f1)"; \
        usermod -l milady -d /home/milady -m "${old}"; \
        groupmod -n milady "$(id -gn milady)" || true; \
    else \
        (getent group "${MILADY_GID}" >/dev/null || groupadd --gid "${MILADY_GID}" milady); \
        useradd --uid "${MILADY_UID}" --gid "${MILADY_GID}" --create-home --shell /bin/bash milady; \
    fi

WORKDIR /opt/milady

# Dépendances épinglées SANS la pile CUDA (torch, triton, nvidia-*, cuda-*), déjà fournie par
# l'image de base : on ne la réinstalle pas, on vérifie seulement la version de torch.
COPY infra/env/requirements-gpu.txt /tmp/requirements-gpu.txt
RUN --mount=type=secret,id=cacert,required=false \
    if [ -f /run/secrets/cacert ]; then export PIP_CERT=/run/secrets/cacert; fi \
 && grep -vE '^(torch|triton|cuda-[a-z-]+|nvidia-[a-z0-9-]+-cu1[0-9])==' /tmp/requirements-gpu.txt \
      | grep -vE '^--extra-index-url' > /tmp/requirements-nocuda.txt \
 && pip install -r /tmp/requirements-nocuda.txt \
 && if [ "${WITH_JUPYTER}" = "1" ]; then pip install "jupyterlab==4.6.4"; fi \
 && python -c "import torch; v = torch.__version__.split('+')[0]; assert v == '2.14.1', v; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

COPY --chown=milady:milady . /opt/milady
RUN --mount=type=secret,id=cacert,required=false \
    if [ -f /run/secrets/cacert ]; then export PIP_CERT=/run/secrets/cacert; fi \
 && pip install --no-deps -e . \
 && mkdir -p /opt/milady/data \
 && chown -R milady:milady /opt/milady \
 && python -c "import milady, h5py, torch; print('milady', milady.__version__)"

USER milady

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-c", "import torch; print('Image MilaDy prête (GPU) ; CUDA visible :', torch.cuda.is_available())"]
