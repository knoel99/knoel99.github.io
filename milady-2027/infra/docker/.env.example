# Variables de la pile docker-compose MilaDy — MODÈLE, sans secret.
#
# Le vrai fichier est infra/docker/.env (ignoré par git). Il est généré automatiquement, avec des
# mots de passe aléatoires, par :
#   sudo infra/deploy/bootstrap_vm.sh       (VM cloud)
#   make env                                (n'importe quelle machine avec Docker)
# ou à la main : cp infra/docker/.env.example infra/docker/.env, puis remplacer chaque « change-me ».
#
# Mots de passe : lettres et chiffres uniquement (ils sont insérés dans des URL de connexion) ;
# par exemple `openssl rand -hex 24`.

# --- Projet ------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=milady
# Adresse d'écoute des ports publiés. Garder 127.0.0.1 (accès par tunnel SSH) sauf réseau privé.
BIND_ADDR=127.0.0.1
# Conteneur de calcul utilisé par le Makefile : worker (CPU) ou worker-gpu (GPU NVIDIA).
MILADY_WORKER=worker
# Préfixe des images construites (milady:cpu, milady:gpu, milady:cpu-jupyter).
MILADY_IMAGE=milady
# UID/GID de l'utilisateur de l'hôte propriétaire du dépôt (fichiers écrits dans le volume monté).
MILADY_UID=1000
MILADY_GID=1000
# Nom de la machine, enregistré dans le catalogue et les fichiers MFF (provenance).
MILADY_HOST=docker

# --- Catalogue PostgreSQL ----------------------------------------------------------------------
POSTGRES_USER=milady
POSTGRES_PASSWORD=change-me
POSTGRES_DB=milady
DB_PORT=5432

# --- Stockage objet S3 (MinIO local) -----------------------------------------------------------
# Compte administrateur MinIO (console web http://localhost:9001 via tunnel SSH).
S3_ROOT_USER=milady-admin
S3_ROOT_PASSWORD=change-me
# Compte applicatif (créé par le service s3-init, droits readwrite) utilisé par les workers et MLflow.
S3_ACCESS_KEY=milady-app
S3_SECRET_KEY=change-me
S3_PORT=9000
S3_CONSOLE_PORT=9001
AWS_DEFAULT_REGION=us-east-1
# Images MinIO (fork communautaire maintenu ; voir infra/README.md, section « Stockage objet »).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-10-18T00-00-00Z

# --- Stockage externe (facultatif) --------------------------------------------------------------
# Pour écrire les fichiers MFF et les points de contrôle dans un bucket du fournisseur plutôt que
# dans MinIO, décommenter et remplir les lignes ci-dessous. Les clés du fournisseur vont dans
# MILADY_S3_ACCESS_KEY / MILADY_S3_SECRET_KEY (ne PAS remplacer S3_ACCESS_KEY / S3_SECRET_KEY, qui
# restent le compte MinIO utilisé par MLflow). Points d'accès donnés à titre d'exemple : vérifier la
# région et l'URL exacte dans la documentation du fournisseur.
# MILADY_STORAGE_URI=s3://mon-bucket-milady/data
# MILADY_MODELS_URI=s3://mon-bucket-milady/models
# MILADY_S3_ACCESS_KEY=<clé d'accès du fournisseur>
# MILADY_S3_SECRET_KEY=<secret du fournisseur>
# MILADY_S3_ENDPOINT=https://s3.fr-par.scw.cloud        # Scaleway (Paris)
# MILADY_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net    # OVHcloud (Gravelines)
# MILADY_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com # AWS (Paris)

# --- MLflow ------------------------------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_EXPERIMENT_NAME=milady
# MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow
# Ajouter ici un nom de domaine si MLflow est exposé derrière un proxy inverse :
# MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*

# --- Jupyter (profil « jupyter ») --------------------------------------------------------------
JUPYTER_PORT=8888
JUPYTER_TOKEN=change-me
