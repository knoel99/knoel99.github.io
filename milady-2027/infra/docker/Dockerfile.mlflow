# syntax=docker/dockerfile:1.7
# Serveur de suivi MLflow : image officielle + pilote PostgreSQL (psycopg2) et client S3 (boto3).
# Utilisée par le service « mlflow » de docker-compose.yml (construite automatiquement par
# `docker compose build` / `make up`).
FROM ghcr.io/mlflow/mlflow:v3.17.2

RUN --mount=type=secret,id=cacert,required=false \
    if [ -f /run/secrets/cacert ]; then export PIP_CERT=/run/secrets/cacert; fi \
 && pip install --no-cache-dir "psycopg2-binary==2.9.13" "boto3==1.43.117" \
 && python -c "import mlflow, psycopg2, boto3; print('mlflow', mlflow.__version__)"
